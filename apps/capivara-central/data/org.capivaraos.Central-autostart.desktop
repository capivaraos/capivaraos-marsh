[Desktop Entry]
Type=Application
Name=Central do Desenvolvedor (primeiro boot)
Name[pt_BR]=Central do Desenvolvedor (primeiro boot)
Comment=Abre a Central do Desenvolvedor uma vez, no primeiro login
Exec=capivara-central --autostart
